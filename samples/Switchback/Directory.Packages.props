<Project>
  <!-- Every package version lives here (central package management). Projects reference packages without versions. -->
  <PropertyGroup>
    <!-- A version below also pins the same package wherever it arrives transitively. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Not referenced directly. Microsoft.Data.SqlClient (through EF Core and FunkyORM) brings 9.0.x, which
         CVE-2026-84008 and CVE-2026-70162 (2026-10-13) affect; the warnings-as-errors build fails on them.
         10.0.13 is the first patched 10.0.x release.
         Remove this line, and the pinning property above, once the EF Core and FunkyORM versions here bring a
         SqlClient that depends on a patched Pkcs. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="Funcular.Data.Orm" Version="3.10.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
  </ItemGroup>
</Project>
